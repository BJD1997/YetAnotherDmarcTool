{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": false,
      "basics": {
        "description": "Deploys YetAnotherDmarcTool on Azure Container Apps with a private (VNet-integrated) PostgreSQL Flexible Server and Key Vault. The api and worker each run a DNSSEC resolver sidecar; the worker autoscales on the background-job queue depth. A migrate job initializes the database during deployment. Pick a deployment size on the Sizing step to pre-fill network, Postgres, and replica-count sizing \u2014 every value stays individually overridable via CLI/parameters file.",
        "resourceGroup": {
          "allowExisting": true
        }
      }
    },
    "basics": [
      {
        "name": "namePrefix",
        "type": "Microsoft.Common.TextBox",
        "label": "Resource name prefix",
        "defaultValue": "yadt",
        "toolTip": "Short prefix for resource names (a lowercase letter followed by 1-11 letters/digits).",
        "constraints": {
          "required": true,
          "regex": "^[a-z][a-z0-9]{1,11}$",
          "validationMessage": "2-12 chars, lowercase letter first, then letters/digits."
        }
      },
      {
        "name": "imageTag",
        "type": "Microsoft.Common.TextBox",
        "label": "Image tag",
        "defaultValue": "latest",
        "toolTip": "Container image tag to deploy, e.g. a release like v0.1.4 or 'latest'.",
        "constraints": {
          "required": true
        }
      }
    ],
    "steps": [
      {
        "name": "secrets",
        "label": "Database & secrets",
        "elements": [
          {
            "name": "administratorLogin",
            "type": "Microsoft.Common.TextBox",
            "label": "Postgres admin login",
            "defaultValue": "dmarcadmin",
            "toolTip": "Administrator login for the PostgreSQL Flexible Server.",
            "constraints": {
              "required": true,
              "regex": "^[a-z][a-z0-9_]{2,62}$",
              "validationMessage": "Lowercase letter first, then letters/digits/underscore."
            }
          },
          {
            "name": "administratorPassword",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Postgres admin password",
              "confirmPassword": "Confirm password"
            },
            "toolTip": "At least 12 characters.",
            "constraints": {
              "required": true,
              "regex": "^.{12,}$",
              "validationMessage": "At least 12 characters."
            },
            "options": {
              "hideConfirmation": false
            }
          },
          {
            "name": "dmarcAppDbPassword",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "App (dmarc_app) DB password",
              "confirmPassword": "Confirm password"
            },
            "toolTip": "Password for the non-owner runtime role the app connects as. At least 12 characters.",
            "constraints": {
              "required": true,
              "regex": "^.{12,}$",
              "validationMessage": "At least 12 characters."
            },
            "options": {
              "hideConfirmation": false
            }
          },
          {
            "name": "fernetKey",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Fernet key",
              "confirmPassword": "Confirm key"
            },
            "toolTip": "Encrypts TOTP secrets/credentials at rest. Generate with: openssl rand -base64 32 | tr '+/' '-_'",
            "constraints": {
              "required": true,
              "regex": "^[A-Za-z0-9_-]{43}=$",
              "validationMessage": "A url-safe base64 32-byte key: 43 letters/digits/-/_ followed by a trailing '='. Generate: openssl rand -base64 32 | tr '+/' '-_'"
            },
            "options": {
              "hideConfirmation": true
            }
          }
        ]
      },
      {
        "name": "sizing",
        "label": "Sizing & domain",
        "elements": [
          {
            "name": "deploymentSize",
            "type": "Microsoft.Common.OptionsGroup",
            "label": "Deployment size",
            "defaultValue": "Small \u2014 a few users: up to 2 api/worker replicas, Burstable B2s Postgres. The default.",
            "toolTip": "Pre-fills network, Postgres, and replica-count sizing. Every value stays individually overridable below.",
            "constraints": {
              "required": true,
              "allowedValues": [
                {
                  "label": "Test \u2014 smallest footprint: single api/worker replica, Burstable B1ms Postgres. For trying it out, not real traffic.",
                  "value": "test"
                },
                {
                  "label": "Small \u2014 a few users: up to 2 api/worker replicas, Burstable B2s Postgres. The default.",
                  "value": "small"
                },
                {
                  "label": "Medium \u2014 a small team/MSP: up to 3 api/worker replicas, General Purpose D2ds_v4 Postgres.",
                  "value": "medium"
                },
                {
                  "label": "Large \u2014 heavier load: 2-5 api replicas, up to 5 worker replicas, General Purpose D4ds_v4 Postgres.",
                  "value": "large"
                }
              ]
            },
            "visible": true
          },
          {
            "name": "postgresHighAvailability",
            "type": "Microsoft.Common.CheckBox",
            "label": "Enable Postgres high availability (zone-redundant)",
            "toolTip": "Adds a synchronously-replicated standby in a second Availability Zone with automatic failover. Roughly doubles Postgres compute cost. Requires a region with Availability Zone support. Not offered for Test/Small \u2014 their Burstable Postgres SKU doesn't support zone redundancy.",
            "visible": "[and(not(equals(steps('sizing').deploymentSize, 'test')), not(equals(steps('sizing').deploymentSize, 'small')))]"
          },
          {
            "name": "publicBaseUrlOverride",
            "type": "Microsoft.Common.TextBox",
            "label": "Custom base URL (optional)",
            "defaultValue": "",
            "toolTip": "e.g. https://dmarc.example.com. Leave blank to use the default Container Apps URL; bind the custom domain + managed certificate after deployment.",
            "constraints": {
              "required": false,
              "regex": "^$|^https://.+$",
              "validationMessage": "Must start with https://, or leave blank."
            }
          }
        ]
      },
      {
        "name": "admin",
        "label": "Platform admin",
        "elements": [
          {
            "name": "platformAdminBootstrapEmail",
            "type": "Microsoft.Common.TextBox",
            "label": "Bootstrap admin email",
            "defaultValue": "",
            "toolTip": "The first platform-admin account, created if none exists. Leave blank to create no admin (you'd have to seed one manually).",
            "constraints": {
              "required": false,
              "regex": "^$|^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
              "validationMessage": "A valid email address, or leave blank."
            }
          },
          {
            "name": "platformAdminBootstrapPassword",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Bootstrap admin password",
              "confirmPassword": "Confirm password"
            },
            "toolTip": "Password for the first platform admin. Required if you set an email above.",
            "constraints": {
              "required": false
            },
            "options": {
              "hideConfirmation": false
            }
          }
        ]
      },
      {
        "name": "entra",
        "label": "Entra (optional)",
        "elements": [
          {
            "name": "info",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "Optional. Leave blank for local email+password+TOTP login and DNS-checks-only use. Fill in to enable Entra SSO (api) and/or Microsoft Graph mailbox report ingestion (worker)."
            }
          },
          {
            "name": "entraSsoClientId",
            "type": "Microsoft.Common.TextBox",
            "label": "Entra SSO client ID",
            "defaultValue": "",
            "constraints": {
              "required": false
            }
          },
          {
            "name": "entraSsoClientSecret",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Entra SSO client secret",
              "confirmPassword": "Confirm"
            },
            "constraints": {
              "required": false
            },
            "options": {
              "hideConfirmation": true
            }
          },
          {
            "name": "entraMailClientId",
            "type": "Microsoft.Common.TextBox",
            "label": "Entra Mail client ID",
            "defaultValue": "",
            "constraints": {
              "required": false
            }
          },
          {
            "name": "entraMailClientSecret",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Entra Mail client secret",
              "confirmPassword": "Confirm"
            },
            "constraints": {
              "required": false
            },
            "options": {
              "hideConfirmation": true
            }
          }
        ]
      },
      {
        "name": "hostedMailbox",
        "label": "Hosted reporting mailbox (optional)",
        "elements": [
          {
            "name": "info",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "One mailbox in your own Microsoft 365 tenant that gives every domain its own reporting address (mailbox+tag@domain), for organizations without a mailbox of their own. Needs the Entra Mail client from the previous step, with Mail Access consent in this tenant. Fill in all three or leave all blank."
            }
          },
          {
            "name": "hostedReportsTenantId",
            "type": "Microsoft.Common.TextBox",
            "label": "Tenant ID of the mailbox",
            "defaultValue": "",
            "constraints": {
              "required": false,
              "regex": "^$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "validationMessage": "A tenant ID looks like 00000000-0000-0000-0000-000000000000."
            }
          },
          {
            "name": "hostedReportsMailboxAddress",
            "type": "Microsoft.Common.TextBox",
            "label": "Mailbox address",
            "defaultValue": "",
            "placeholder": "reports@example.com",
            "constraints": {
              "required": false,
              "regex": "^$|^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
              "validationMessage": "Enter an email address."
            }
          },
          {
            "name": "hostedReportsAddressDomain",
            "type": "Microsoft.Common.TextBox",
            "label": "Address domain",
            "defaultValue": "",
            "placeholder": "example.com",
            "toolTip": "The domain of the hosted addresses. Must be the mailbox address's own domain: plus-addressing only works within one domain.",
            "constraints": {
              "required": false,
              "validations": [
                {
                  "isValid": "[or(empty(steps('hostedMailbox').hostedReportsAddressDomain), equals(toLower(steps('hostedMailbox').hostedReportsAddressDomain), toLower(last(split(steps('hostedMailbox').hostedReportsMailboxAddress, '@')))))]",
                  "message": "Must be the mailbox address's own domain."
                },
                {
                  "isValid": "[or(and(empty(steps('hostedMailbox').hostedReportsTenantId), empty(steps('hostedMailbox').hostedReportsMailboxAddress), empty(steps('hostedMailbox').hostedReportsAddressDomain)), and(not(empty(steps('hostedMailbox').hostedReportsTenantId)), not(empty(steps('hostedMailbox').hostedReportsMailboxAddress)), not(empty(steps('hostedMailbox').hostedReportsAddressDomain))))]",
                  "message": "Fill in all three fields, or leave all three blank."
                }
              ]
            }
          }
        ]
      },
      {
        "name": "cloudflare",
        "label": "Cloudflare (optional)",
        "elements": [
          {
            "name": "info",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "Only with a hosted reporting mailbox, and only if the address domain's DNS is on Cloudflare. Creates the DMARC authorization record each domain using a hosted address needs, and removes it again when the domain is deleted. Without this, you add those records by hand; the app shows which. Use an API token limited to DNS edit on that one zone."
            }
          },
          {
            "name": "cloudflareZoneId",
            "type": "Microsoft.Common.TextBox",
            "label": "Zone ID",
            "defaultValue": "",
            "constraints": {
              "required": false,
              "regex": "^$|^[0-9a-f]{32}$",
              "validationMessage": "A zone ID is 32 lowercase hex characters (Cloudflare dashboard \u2192 the domain \u2192 Overview)."
            }
          },
          {
            "name": "cloudflareApiToken",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "API token",
              "confirmPassword": "Confirm"
            },
            "constraints": {
              "required": false
            },
            "options": {
              "hideConfirmation": true
            }
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "namePrefix": "[basics('namePrefix')]",
      "imageTag": "[basics('imageTag')]",
      "deploymentSize": "[steps('sizing').deploymentSize]",
      "postgresHighAvailability": "[if(coalesce(steps('sizing').postgresHighAvailability, false), 'ZoneRedundant', 'Disabled')]",
      "administratorLogin": "[steps('secrets').administratorLogin]",
      "administratorPassword": "[steps('secrets').administratorPassword]",
      "dmarcAppDbPassword": "[steps('secrets').dmarcAppDbPassword]",
      "fernetKey": "[steps('secrets').fernetKey]",
      "platformAdminBootstrapEmail": "[steps('admin').platformAdminBootstrapEmail]",
      "platformAdminBootstrapPassword": "[steps('admin').platformAdminBootstrapPassword]",
      "entraSsoClientId": "[steps('entra').entraSsoClientId]",
      "entraSsoClientSecret": "[steps('entra').entraSsoClientSecret]",
      "entraMailClientId": "[steps('entra').entraMailClientId]",
      "entraMailClientSecret": "[steps('entra').entraMailClientSecret]",
      "hostedReportsTenantId": "[steps('hostedMailbox').hostedReportsTenantId]",
      "hostedReportsMailboxAddress": "[steps('hostedMailbox').hostedReportsMailboxAddress]",
      "hostedReportsAddressDomain": "[steps('hostedMailbox').hostedReportsAddressDomain]",
      "cloudflareZoneId": "[steps('cloudflare').cloudflareZoneId]",
      "cloudflareApiToken": "[steps('cloudflare').cloudflareApiToken]",
      "publicBaseUrlOverride": "[steps('sizing').publicBaseUrlOverride]"
    }
  }
}
