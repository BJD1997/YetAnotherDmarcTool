# Copy to .env and fill in before `docker compose up`.
# .env is git-ignored — never commit real secrets.

ENVIRONMENT=development

# Public HTTPS URL this app will be reachable at through the NPM VM,
# e.g. https://dmarc.yourdomain.com — must match the redirect_uri
# registered in both Entra app registrations (Phase 1/2).
PUBLIC_BASE_URL=https://dmarc.example.com

# The IP address your reverse proxy connects to this app from — e.g. NPM's
# own IP as seen by this host. Without this, every logged IP (sessions,
# the sign-in audit log) is your reverse proxy's IP, not the real visitor's
# — uvicorn only trusts the X-Forwarded-For header from an explicitly
# listed peer (see docker-compose.yml's api command). Find the wrong value
# currently being logged (Settings > Sign-in activity, or any session's
# ip_address) and set this to that address. Leave unset (defaults to
# 127.0.0.1, i.e. trust nothing external) if this app isn't behind a
# reverse proxy.
FORWARDED_ALLOW_IPS=

# --- Postgres ---
# POSTGRES_USER/PASSWORD is the DB *owner* role (superuser, created by the
# postgres image itself) — used only by the one-off `migrate` container to
# run Alembic (CREATE TABLE, CREATE POLICY, etc).
POSTGRES_USER=dmarc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dmarc

# DMARC_APP_DB_PASSWORD is for the separate non-superuser `dmarc_app` role
# that api/worker actually connect as at runtime (see db/init/01-create-app-role.sh)
# — this is what makes row-level security actually apply (table owners, and
# any superuser, are exempt from RLS regardless of FORCE ROW LEVEL SECURITY).
DMARC_APP_DB_PASSWORD=change-me

# --- Fernet key (REQUIRED) ---
# Encrypts TOTP secrets at rest (every local-auth user and platform admin) and
# the optional per-org custom-app-credential escape hatch. Required because
# platform-admin login enrolls TOTP, which fails closed without this. Losing or
# changing it makes existing TOTP enrollments (and stored credentials)
# undecryptable — back it up, and don't reuse it across instances.
# Generate with either (no Python needed for the first):
#   openssl rand -base64 32 | tr '+/' '-_'
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Entra App A: Mail Access (application permission, Graph client-credentials) (Phase 2) ---
# Not optional the way the rest of this file is: an org connecting its own
# mailbox (app/routers/mailbox_connections.py) and the operator-hosted
# mailbox (app/workers/jobs/hosted_reports_poll_job.py) both authenticate to
# Microsoft Graph through this one app-only app registration
# (app/services/graph/client_credentials.py). Leave it unset and the
# dashboard still runs fine — DNS best-practice checks work with zero
# Microsoft-side config — but no report is ever ingested by either path.
ENTRA_MAIL_CLIENT_ID=
ENTRA_MAIL_CLIENT_SECRET=

# --- Entra App B: Dashboard SSO (delegated, OIDC) (Phase 1) ---
# Genuinely optional — local email+password+TOTP login works with this unset.
ENTRA_SSO_CLIENT_ID=
ENTRA_SSO_CLIENT_SECRET=

# --- Operator-hosted reporting mailbox (optional) ---
# <mailbox-local-part>+<tag>@HOSTED_REPORTS_ADDRESS_DOMAIN addresses, issued
# via POST /domains/{id}/hosted-report-address, land in
# HOSTED_REPORTS_MAILBOX_ADDRESS via plus-addressing (in the Entra tenant
# HOSTED_REPORTS_TENANT_ID, polled the same way as any other
# MailboxConnection). HOSTED_REPORTS_ADDRESS_DOMAIN MUST be the same domain
# as HOSTED_REPORTS_MAILBOX_ADDRESS — plus-addressing doesn't route across
# domains, and a catch-all isn't assumed to be available (Exchange Online
# has none). Leave all three blank to disable the feature entirely (POST
# returns 409 either way).
HOSTED_REPORTS_TENANT_ID=
HOSTED_REPORTS_MAILBOX_ADDRESS=
HOSTED_REPORTS_ADDRESS_DOMAIN=

# --- Cloudflare (optional) --- auto-creates the RFC 7489 §7.1 authorization
# record each domain using it needs on HOSTED_REPORTS_ADDRESS_DOMAIN's zone.
# Scoped API Token (Zone:DNS:Edit on that one zone), not the legacy Global
# API Key. Leave blank to fall back to manual instructions instead.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Platform admin bootstrap (Phase 1) ---
# If no platform_admins row exists yet, the `migrate` container creates one
# from these on startup. Change the password after first login; these vars
# can then be left blank (bootstrap is a no-op once an admin already exists).
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=change-me

# --- security.txt (optional, RFC 9116) ---
# Publishes /.well-known/security.txt with this contact for vulnerability
# reports. Leave blank to not serve it at all — there's nothing RFC-9116-
# correct to publish without at least one contact.
SECURITY_CONTACT_EMAIL=

# --- This instance's own MTA-STS policy (optional) ---
# Not an organization-facing feature — organizations publish/host their own
# (see the Policy Builder), this app stays read-only toward their DNS. This
# is only for the operator's own domain, if it sends mail and you want to publish
# your own MTA-STS policy through this same app instance rather than
# somewhere else. Leave both blank to not serve it at all. MTA_STS_POLICY_HOSTNAME
# must exactly match the Host header of incoming requests (i.e. the
# mta-sts.<yourdomain> hostname you've pointed at this app), and
# MTA_STS_POLICY_BODY is the literal policy file content, newline-separated,
# e.g.:
#   version: STSv1
#   mode: testing
#   mx: yourmailhost.example.com
#   max_age: 604800
MTA_STS_POLICY_HOSTNAME=
MTA_STS_POLICY_BODY=

# --- Updates (optional) ---
# APP_VERSION is a different concept from the same-named Dockerfile ARG:
# this one (used in docker-compose.yml's image: fields) picks which
# published tag `docker compose pull` fetches; the Dockerfile ARG only
# matters for a from-source `docker compose build`. Leave unset to track
# `latest`.
APP_VERSION=

# Enables the "Update now" button in the admin console (see
# docker-compose.yml's updater service and updater/server.py) — a
# container with Docker socket access, which is host-root-equivalent.
# Leave blank to not run it at all; the admin console still shows
# "update available" notices from the periodic check either way, just
# without a one-click trigger. Generate with: openssl rand -hex 32
UPDATER_SHARED_SECRET=
