# Copy to .env and fill in before `docker compose up`.
# .env is git-ignored — never commit real secrets.

ENVIRONMENT=development

# Public HTTPS URL this app will be reachable at through the NPM VM,
# e.g. https://dmarc.yourdomain.com — must match the redirect_uri
# registered in both Entra app registrations (Phase 1/2).
PUBLIC_BASE_URL=https://dmarc.example.com

# --- Postgres ---
# POSTGRES_USER/PASSWORD is the DB *owner* role (superuser, created by the
# postgres image itself) — used only by the one-off `migrate` container to
# run Alembic (CREATE TABLE, CREATE POLICY, etc).
POSTGRES_USER=dmarc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dmarc

# DMARC_APP_DB_PASSWORD is for the separate non-superuser `dmarc_app` role
# that api/worker actually connect as at runtime (see db/init/01-create-app-role.sh)
# — this is what makes row-level security actually apply (table owners, and
# any superuser, are exempt from RLS regardless of FORCE ROW LEVEL SECURITY).
DMARC_APP_DB_PASSWORD=change-me

# --- Sessions (Phase 1) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me

# --- Fernet key for the optional per-org custom-app-credential escape hatch (Phase 1+) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Entra App A: Mail Access (application permission, Graph client-credentials) (Phase 2) ---
ENTRA_MAIL_CLIENT_ID=
ENTRA_MAIL_CLIENT_SECRET=

# --- Entra App B: Dashboard SSO (delegated, OIDC) (Phase 1) ---
ENTRA_SSO_CLIENT_ID=
ENTRA_SSO_CLIENT_SECRET=

# --- Platform admin bootstrap (Phase 1) ---
# If no platform_admins row exists yet, the `migrate` container creates one
# from these on startup. Change the password after first login; these vars
# can then be left blank (bootstrap is a no-op once an admin already exists).
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=change-me
