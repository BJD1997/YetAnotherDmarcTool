# Copy to .env.demo and fill in before `docker compose -f docker-compose.demo.yml up`.
# .env.demo is git-ignored — never commit real secrets.
#
# This is a separate, fully isolated deployment (see docker-compose.demo.yml)
# meant for a public, read-only demo — most of these are the same as the
# real .env.example, but a few things are different or new. See that file's
# comments for anything not re-explained here.

ENVIRONMENT=production

# The demo's own hostname — different from your real instance's.
PUBLIC_BASE_URL=https://demo.yourdomain.com

# See .env.example's own comment — same reverse-proxy IP, since both
# deployments sit behind the same NPM instance on this host.
FORWARDED_ALLOW_IPS=

# --- Postgres --- own DB, own credentials, not shared with the real instance.
POSTGRES_USER=dmarc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dmarc
DMARC_APP_DB_PASSWORD=change-me

# --- Fernet key --- generate a fresh one, don't reuse the real instance's.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Entra apps (optional) --- only needed if the demo org itself uses
# Entra SSO/mailbox polling (e.g. to show real report ingestion for your
# own domain) rather than local auth alone.
ENTRA_MAIL_CLIENT_ID=
ENTRA_MAIL_CLIENT_SECRET=
ENTRA_SSO_CLIENT_ID=
ENTRA_SSO_CLIENT_SECRET=

# --- Operator-hosted reporting mailbox / Cloudflare / security.txt / MTA-STS ---
# Leave all blank unless the demo specifically needs them too — most demos
# don't, since the point is showing off the app, not running these
# operator-only features a second time.
HOSTED_REPORTS_TENANT_ID=
HOSTED_REPORTS_MAILBOX_ADDRESS=
HOSTED_REPORTS_ADDRESS_DOMAIN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
SECURITY_CONTACT_EMAIL=
MTA_STS_POLICY_HOSTNAME=
MTA_STS_POLICY_BODY=

# --- Platform admin bootstrap ---
# A real login you control, for setting up the demo org/domain in the first
# place (see app/scripts/seed_demo.py) — not what's published as the demo
# login itself.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=change-me

# --- The published demo login itself (required) ---
# app/scripts/seed_demo.py creates exactly one org + one local-auth user
# with these credentials, flagged is_demo_read_only=true — this is what
# gets shown publicly on the README/login page. Use a password you're fine
# with anyone in the world knowing.
DEMO_LOGIN_EMAIL=demo@yourdomain.com
DEMO_LOGIN_PASSWORD=change-me
